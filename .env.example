# Database
DATABASE_URL="postgresql://openpims:openpims@localhost:5432/openpims"

# NextAuth
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# S3-compatible storage (MinIO for local dev)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="openpims"
S3_SECRET_KEY="openpims123"
S3_BUCKET="openpims"
S3_REGION="us-east-1"

# Resend (email)
RESEND_API_KEY=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cron job authentication
CRON_SECRET=

# Ops alerting — failures in background jobs (reminders, backups, webhook
# delivery) post here (Slack-style incoming webhook). Optional; logs if unset.
OPS_ALERT_WEBHOOK_URL=

# Lab Integrations
IDEXX_API_KEY=
ANTECH_API_KEY=
ZOETIS_API_KEY=

# OpenVPM Agent (AI). Without ANTHROPIC_API_KEY the agent UI shows a setup
# notice and agent runs are disabled; everything else works normally.
ANTHROPIC_API_KEY=
# Optional model override for the agent (defaults to claude-sonnet-4-6).
AGENT_MODEL=
